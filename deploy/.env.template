# Copy to deploy/.env and fill in. Compose reads it for substitution, and the
# api and jobs containers receive every line as an environment variable, so
# leave a variable commented out rather than empty: the API treats an empty
# SKYSPACE_SMTP_HOST as "SMTP configured" and refuses to start.

# The public hostname Caddy serves and gets a certificate for. Use
# `localhost` for a laptop run (Caddy issues its own certificate).
SKYSPACE_DOMAIN=

# Postgres superuser password for the bundled database. Anything long.
POSTGRES_PASSWORD=

# A real address Rice can reach; every pull job identifies itself with it,
# and the privacy page shows it. Pulls refuse to run without one.
SKYSPACE_CONTACT_EMAIL=

# The term the jobs pull (Rice's six-digit code; 202710 is Fall 2026). Which
# term the site *opens on* is `skyspace term set-current`, not this.
SKYSPACE_TERM=202710

# Staging without SMTP: plain-text logs, and each sign-in code is written to
# the api log (redacted address). Production: SKYSPACE_LOG_JSON=1, which
# also guarantees no code can ever reach a log, and the SMTP block below.
SKYSPACE_LOG_JSON=0
SKYSPACE_LOG_LOGIN_CODES=1

# Mail for sign-in codes. Uncomment all five together.
#SKYSPACE_SMTP_HOST=
#SKYSPACE_SMTP_PORT=587
#SKYSPACE_SMTP_USERNAME=
#SKYSPACE_SMTP_PASSWORD=
#SKYSPACE_SMTP_FROM=

# Which data the browser app talks to. `demo` until web/src/datasource has
# an API source; the value is baked in at image build time.
VITE_DATA_SOURCE=demo
